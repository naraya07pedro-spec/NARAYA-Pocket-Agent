{
  "name": "naraya-pocket-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "test": "node scripts/release-preflight.mjs && node --experimental-strip-types --test tests/pocket.test.mjs tests/oidc.test.mjs tests/mobile-sync.test.mjs tests/release-preflight.test.mjs tests/offdevice-evidence.test.mjs tests/cloudflare-readonly-inspect.test.mjs tests/cloudflare-billing-readonly.test.mjs tests/cloudflare-owner-acceptance.test.mjs tests/android-owner-pilot.test.mjs tests/android-apk-signature.test.mjs",
    "typecheck": "tsc --noEmit -p worker/tsconfig.json",
    "preflight": "node scripts/release-preflight.mjs",
    "preflight:json": "node scripts/release-preflight.mjs --json",
    "preflight:require-remote": "node scripts/release-preflight.mjs --require-remote",
    "cloudflare:inspect-offline": "node scripts/cloudflare-readonly-inspect.mjs",
    "cloudflare:inspect-live": "node scripts/cloudflare-readonly-inspect.mjs --inspect-live",
    "cloudflare:billing-offline": "node scripts/cloudflare-billing-readonly.mjs",
    "cloudflare:billing-live": "node scripts/cloudflare-billing-readonly.mjs --inspect-live",
    "cloudflare:owner-offline": "node scripts/cloudflare-owner-acceptance.mjs",
    "cloudflare:owner-live": "node scripts/cloudflare-owner-acceptance.mjs --inspect-live",
    "android:owner-inspect": "node scripts/android-owner-pilot.mjs --inspect",
    "android:owner-bootstrap": "node scripts/android-owner-pilot.mjs --bootstrap",
    "android:owner-pin": "node scripts/android-owner-pilot.mjs --pin",
    "android:verify-apk": "node scripts/android-owner-pilot.mjs --verify-apk"
  }
}
